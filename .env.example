# All three private keys stay on the server. Never prefix them NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_PARSE_MODEL=gpt-4.1-mini
# Optional low-cost nutrition fallback; called only after no food match.
OPENAI_ESTIMATE_MODEL=gpt-4.1-mini
# Reads printed nutrition facts from a label photo (not food-photo estimates).
OPENAI_LABEL_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
USDA_API_KEY=
# Enable Anonymous Sign-Ins and run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Personal app: use this instead of Supabase auth. Generate a long random code; enter once per device.
# This protects paid AI endpoints, while logs remain on the device. Do not prefix NEXT_PUBLIC_.
COUNTER_ACCESS_CODE=
